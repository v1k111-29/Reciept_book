          "title": "OrgRole",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Frontend -> backend. Carries the RAW reference (IRM / eBRC number / document id);\nthe backend hashes it with the server-side salt and sends a MilestoneSubmission on.\nThe raw value is never stored or logged (FEATURES.md E9).",
      "properties": {
        "acting_as": {
          "$ref": "#/$defs/OrgRole"
        },
        "customs_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomsStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "milestone": {
          "$ref": "#/$defs/Milestone"
        },
        "occurred_on": {
          "description": "Date the real-world step happened, as attested by the submitter. For DOCS_ACKNOWLEDGED it is the date the exporter handed the documents over (pilot measure 1).",
          "format": "date",
          "title": "Occurred On",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "milestone",
        "occurred_on",
        "acting_as"
