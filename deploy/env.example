# Documents deploy/.env, which `bash scripts/deploy.sh up` creates on its first run (mode 600,
# gitignored). You do not need to copy this file; edit deploy/.env afterwards if you must.
# Keep single quotes around values: compose then takes them literally, which the '$' signs in a
# bcrypt hash need. (This file is named env.example, not .env.example, because .gitignore
# ignores .env.*.)

# Salt for every hash the backend writes to the ledger (openssl rand -hex 32).
# NEVER change it on a deployment that has data: every record and reference hash on the ledger
# was made with it, and a new salt orphans all of them. Back it up somewhere safe.
S14_HASH_SALT='<64 hex characters>'

# ':80' serves plain HTTP on port 80. A domain name (receipts.example.org) whose DNS points at
# this VM gives automatic HTTPS from Let's Encrypt; ports 80 and 443 must then be reachable.
SITE_ADDRESS=':80'

# The one shared login for the whole site (UI and API).
BASIC_AUTH_USER='receiptbook'

# bcrypt hash of the password: docker run --rm caddy:2.10 caddy hash-password --plaintext '<password>'
# Only the hash is stored. To rotate the password see docs/DEPLOY.md.
BASIC_AUTH_HASH='$2a$14$<rest of the hash>'
