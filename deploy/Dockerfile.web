# UI build + Caddy reverse proxy for the single-VM kit (docs/DEPLOY.md). Build context: repository root.
FROM node:22-slim AS build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
# `npm run build` type-checks src and test (frontend/tsconfig.json), then runs vite build.
COPY frontend/ ./
RUN npm run build

# Pinned minor version; scripts/deploy.sh hashes the password with the same image (CADDY_IMAGE).
FROM caddy:2.10
COPY --from=build /frontend/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# The official image runs `caddy run --config /etc/caddy/Caddyfile --adapter caddyfile`.
# SITE_ADDRESS, BASIC_AUTH_USER and BASIC_AUTH_HASH come from the compose file.
