#!/usr/bin/env bash
# Local guard: blocks pushes that break the branch rules (CONTRIBUTING.md).
# Install once per clone: bash scripts/install-hooks.sh
# This is a safety net, NOT the enforcement: GitHub branch protection is (see CONTRIBUTING.md).
# Never bypass it with --no-verify. If it blocks you wrongly, tell the team lead.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# shellcheck disable=SC1091
source "$ROOT/scripts/team.conf"
ID="$(git config --get s14.id || true)"
if [[ -z "$ID" || " $MEMBER_IDS " != *" $ID "* ]]; then
  echo "pre-push: set your team id first:  git config s14.id p<N>   (one of: $MEMBER_IDS)" >&2
  exit 1
fi
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  if [[ "$remote_ref" == refs/tags/* ]]; then
    [[ "$ID" == "$LEAD_ID" ]] || { echo "pre-push: only the lead ($LEAD_ID) pushes tags" >&2; fail=1; }
    continue
  fi
  branch="${remote_ref#refs/heads/}"
  deleting=$([[ "$local_sha" == "$ZERO" ]] && echo 1 || echo 0)
  case "$branch" in
    main|develop|integration/*)
      if [[ "$ID" != "$LEAD_ID" ]]; then
        echo "pre-push: '$branch' is lead-only. Push to your own branch ($ID/...) and open a PR to develop." >&2
        fail=1; continue
      fi
      if [[ "$deleting" == 1 && "$branch" != integration/* ]]; then
        echo "pre-push: refusing to delete '$branch'" >&2; fail=1; continue
      fi
      if [[ "$remote_sha" != "$ZERO" && "$deleting" == 0 && "$branch" != integration/* ]] && \
         ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: non-fast-forward (force) push to '$branch' refused" >&2; fail=1
      fi
      ;;
    "$ID"/*) ;;  # your own branches: allowed (force-push allowed after rebase)
    *)
      echo "pre-push: '$branch' is not yours. Your branches must start with '$ID/'." >&2
      fail=1
      ;;
  esac
done
exit $fail
